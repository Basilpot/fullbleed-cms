{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fullbleed",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },
  "routes": [{ "pattern": "fullbleed.basilpot.com", "custom_domain": true }],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "cache": { "enabled": true },
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fullbleed",
      "database_id": "50947ec2-477c-4c86-8627-2ed604c56d6a",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "fullbleed-media" }],
  "vars": {
    "APP_URL": "https://fullbleed.basilpot.com",
    "MEDIA_URL": "https://media.fullbleed.basilpot.com",
    "PLATFORM_ADMIN_EMAIL": "tejghartikshetri@gmail.com",
    "RESEND_FROM": "Fullbleed <fullbleed@basilpot.com>"
  }
}
